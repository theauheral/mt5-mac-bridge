# =============================================================================
# Dockerfile.mt5 — headless MetaTrader 5 + rpyc bridge for Apple Silicon
# =============================================================================
#
#  ⚠️  STARTING TEMPLATE — NOT BUILD-VERIFIED IN THIS REPO.
#
#  Standing up MT5 under Wine is genuinely fiddly and broker-specific (it needs
#  your broker's MT5 installer and a one-time manual login). The fully-maintained
#  image ships with the upstream `siliconmetatrader5` project — but its public
#  GitHub repo (github.com/buiscimen/siliconmetatrader5) returned 404 when this
#  file was written, and the pip package contains only the *client* + rpyc
#  `server.py`, not the Docker build assets.
#
#  So this Dockerfile encodes the well-established Wine + Windows-Python + MT5 +
#  rpyc pattern (the same approach mt5linux/siliconmetatrader5 use) as a credible
#  starting point. Expect to iterate. The verified, working path today is the
#  MOCK backend (no Docker); see README_MT5_SETUP.md.
#
#  Build is x86_64 (amd64) — under Colima QEMU emulation on Apple Silicon.
# =============================================================================

FROM scottyhardy/docker-wine:latest

ENV WINEDEBUG=-all \
    WINEPREFIX=/root/.wine \
    DISPLAY=:100 \
    MT5_RPYC_PORT=18812

# --- OS deps: VNC stack + a Linux Python to launch the rpyc bootstrap --------
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb x11vnc novnc websockify netcat-openbsd python3 python3-pip wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# --- Windows Python (under Wine) + the real MetaTrader5 package ---------------
# Windows Python MUST be <= 3.13 (MetaTrader5 has no 3.14 wheel).
ENV WINPY_VER=3.11.9
RUN wget -q "https://www.python.org/ftp/python/${WINPY_VER}/python-${WINPY_VER}-amd64.exe" -O /tmp/winpy.exe \
    && xvfb-run -a wine /tmp/winpy.exe /quiet InstallAllUsers=1 PrependPath=1 \
    && xvfb-run -a wine python -m pip install --no-cache-dir MetaTrader5 rpyc plumbum \
    ; echo "NOTE: if the above fails, install Windows Python + MetaTrader5 manually via the VNC session."

# --- MetaTrader 5 terminal ----------------------------------------------------
# The generic MetaQuotes installer; many brokers ship their own — swap the URL.
RUN wget -q "https://download.mql5.com/cdn/web/metaquotes.software.corp/mt5/mt5setup.exe" -O /tmp/mt5setup.exe || true

# --- The rpyc bridge server (bundled inside the pip package) ------------------
# siliconmetatrader5 exposes `python -m siliconmetatrader5 <win_python> -p PORT`,
# which copies its server.py next to a Windows Python and runs the rpyc service.
RUN python3 -m pip install --no-cache-dir --break-system-packages siliconmetatrader5 || \
    python3 -m pip install --no-cache-dir siliconmetatrader5

COPY start.sh /usr/local/bin/start.sh
RUN chmod +x /usr/local/bin/start.sh

EXPOSE 18812 6081
ENTRYPOINT ["/usr/local/bin/start.sh"]
